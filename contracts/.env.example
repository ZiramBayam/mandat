# Forge reads this file. contracts/.env is gitignored; contracts/.env.example is tracked.
# Docs: working/constraints.md
#
# Digest SKILL.md yang disetujui pengguna, diikat di dalam terms
# SkillAuthorityEnforcer. Diisi dari compiled.json.
MANIFEST_HASH=

# ENVELOPE_NOW mengikat output envelope-cli supaya compiled.json reproducible.
# Isi dengan timestamp detik yang dipakai saat rekam demo.
ENVELOPE_NOW=1791196855

MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_WSS_URL=wss://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Block yang dipakai forge test. Endpoint publik tidak menyediakan state
# historis jauh ke belakang, jadi angka ini harus di-update kalau tes gagal
# dengan "Block requested not found".
MONAD_FORK_BLOCK=65825199

# Alias untuk nama yang dipanggil Base.t.sol. Dipakai kalau ada yang membaca
# env dengan konvensi MONAD_<CHAIN>_<METHOD>.
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# --- Akun demo, semua di-chain pada testnet -------------------------------
#
# Hanya DEPLOYER yang punya MON. Sisanya 0 sampai diisi di sini, dan tanpa
# itu redeem tidak bisa dikirim karena gas dibayar oleh AGENT.

# Deployer. contracts/.env yang dipakai forge script, bukan yang di root.
DEPLOYER_PRIVATE_KEY=

# Root delegator,EOA yang di-delegasi 7702 ke DTK deleGator. Saldo MON
# sudah di-wrap ke WMON sebelum di-delegasi, karena setelah di-delegasi EOA
# tidak bisa menurunkan saldonya sendiri.
USER_PRIVATE_KEY=

# Leaf delegate yang mengirim redeemDelegations dan membayar gasnya.
AGENT_PRIVATE_KEY=

# Satu tingkat redelegasi, untuk adegan "pencabutan mematikan turunan".
SUBAGENT_PRIVATE_KEY=

# --- Parameter demo -------------------------------------------------------
#
# Semua punya default di script/G6Setup.s.sol, jadi tidak wajib diisi.
# MANIFEST_CID=
# DELEGATION_SALT=1
DELEGATION_SALT=2
# WRAP_AMOUNT_WEI=1000000000000000000
# PARENT_DELEGATION_HASH=

# Alamat enforcer. Tiga builtin DTK sudah live di kedua chain. Timestamp dan
# LimitedCalls kita deploy sendiri karena salt CREATE2 DTK tidak dipublikasikan,
# jadi alamatnya tidak bisa diturunkan. Parity-nya diuji di
# test/CaveatEnforcerParity.t.sol. Isi setelah menjalankan
# script/DeployCaveatEnforcers.s.sol.
ENFORCER_ALLOWED_TARGETS=0x7F20f61b1f09b08D970938F6fa563634d65c4EeB
ENFORCER_ALLOWED_METHODS=0x2c21fD0Cb9DC8445CB3fb0DC5E7Bb0Aca01842B5
ENFORCER_ERC20_PERIOD=0x474e3Ae7E169e940607cC624Da8A15Eb120139aB
ENFORCER_TIMESTAMP=
ENFORCER_LIMITED_CALLS=

# Alamat hasil deploy. Diisi setelah G2.
AUTHORITY_REGISTRY=0xb51807EC9C8090c155E80B085ebdD999CCf68D30
SKILL_AUTHORITY_ENFORCER=0x5c6EE4586ACABcb6326069c229E58091B21ef384
ERC8004_IDENTITY=
# Root delegator untuk demo. Ganti dengan hasil script/DeployRootDeleGator.s.sol.
# MultiSigDeleGator di belakang ERC-1967 proxy, signer = USER, threshold 1.
# Dipakai karena Monad testnet tidak menerapkan state delegation 7702; lihat
# working/constraints.md 11.
ROOT_DELEGATOR=0xDf9E68Bee379A298709aeb94072d1b1b9A333921

# --- Seller demo -----------------------------------------------------------
# Alamat yang menerima x402.默认 sama dengan deployer untuk demo.
SELLER_ADDRESS=
# Kunci penandatangan audit trail. Boleh sama dengan deployer pada demo; yang
# penting dicek tidak kosong, karena log tanpa tanda tangan tidak bisa diaudit.
SELLER_AUDIT_PRIVATE_KEY=
SELLER_PORT=4020
# Token yang dipakai untukmenentukan harga tier harga seller. Harus sama dengan token cap
# di envelope skill, kalau tidak seller akan menolak karena tidak bisa
# membandingkan base unit lintas token.
CAP_TOKEN=
