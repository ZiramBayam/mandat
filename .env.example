# Salin ke .env lalu isi. JANGAN commit .env.
# contracts/.env sudah masuk .gitignore.

# Deployer + akun pengguna (EOA yang di-delegasi 7702).
# Testnet MON dulu, minimal 12 MON: lihat working/constraints.md 2.3
# aturan reserve 10 MON. Ganti ke alamatmu sendiri.
DEPLOYER_PRIVATE_KEY=
USER_PRIVATE_KEY=

# Leaf delegate, yang mengirim redeemDelegations dan membayar gas. ~1 MON.
AGENT_PRIVATE_KEY=

# Satu tingkat redelegasi untuk demo. ~0.5 MON.
SUBAGENT_PRIVATE_KEY=

# LLM untuk S5. Opsional: tanpa ini, S5 dilewati dan G6 tetap submit-able.
# Regional, dari https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
