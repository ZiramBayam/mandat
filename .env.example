# Salin ke .env lalu isi. JANGAN commit .env.
# contracts/.env sudah masuk .gitignore.

# Deployer + akun pengguna (EOA yang di-delegasi 7702).
# Ganti dengan alamatmu sendiri.
#
# Jumlah MON yang dibutuhkan:-ui kit butuh jauh lebih sedikit dari yang
# tertulis di working/constraints.md 2.3. Angka 12 MON di sana dihitung saat
# gas 0,102 gwei; base fee testnet sekarang 100 gwei, sekitar 1000x lebih
# tinggi. Satu rekaman G6 (2 registrasi + 1 redeem + 1 revoke) memakai
# sekitar 0,15 MON. 1 MON per akun sudah cukup untuk seluruh demo.
#
# Testnet MON dari faucet agents.devnads.com, 1 MON per permintaan:
#   curl -X POST https://agents.devnads.com/v1/faucet \
#     -H "Content-Type: application/json" \
#     -d '{"chainId":10143,"address":"0x..."}'
DEPLOYER_PRIVATE_KEY=
USER_PRIVATE_KEY=

# Leaf delegate, yang mengirim redeemDelegations dan membayar gas semua
# redemption. Kalau hanya satu akun yang bisa diisi, isi yang ini: tanpa saldo
# di sini tidak ada redemption yang bisa dikirim.
AGENT_PRIVATE_KEY=

# Satu tingkat redelegasi untuk demo adegan pencabutan.
SUBAGENT_PRIVATE_KEY=

# --- S5: model untuk agen yang membatasi diri sendiri --------------------
#
# Opsional. Tanpa kunci ini, S5 dilewati dan submission tetap submit-able,
# karena bukti intinya adalah pasangan tx G6, bukan output model.
#
# Gemini. working/prd.md §4 masih menyebut qwen3.8-max, ditulis sebelum
# ketersediaan model dievaluasi; penggantiannya dijelaskan di README.
# S5 tidak bergantung pada model tertentu: yang dibuktikan adalah agen membaca
# cap-nya sendiri lalu memutuskan, dan itu berlaku untuk model apa pun.
#
# PEMERHATIAN: kunci yang pernah muncul di percakapan, log, atau screenshot
# harus dianggap bocor dan langsung dirotasi. Jangan pernah commit kunci ini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash