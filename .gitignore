# Artefak build
node_modules/
.pnpm-store/
frontend/dist/
frontend/.vite/
frontend/.next/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# Foundry. contracts/lib/ SENGAJA tidak ada di sini.
# Ia submodule yang harus di-commit, kalau tidak `forge build`
# gagal di mesin siapa pun yang clone.
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/.env

# Rahasia. Lihat contracts/.env.example dan .env.example di root.
.env
.env.*
!.env.example

# working/ tidak masuk sini. Dokumen kerja tidak boleh di-commit (R1),
# tapi juga tidak boleh di-gitignore, karena itu menyembunyikannya
# dari git status dan berbahaya. Aturannya: jangan pernah `git add`.

# reference/ = clone repo pihak ketiga yang jadi sumber layer animasi
# frontend. Berlawanan dengan working/ di atas, dan itu disengaja.
#
# Bedanya: working/ berisi dokumen kita sendiri, jadi kalau hilang dari
# git status kita lupa isinya. reference/ berisi KODE orang lain, dan
# kalau tidak di-gitignore, `git add -A` akan menyapunya sebagai gitlink
# (mode 160000) -- commit kita lalu menunjuk ke commit di repo mereka
# alih-alih menyalin kodenya, dan tidak bisa di-push.
#
# Clone-nya juga sudah tanpa .git, jadi kedua lapisan itu terpisah.
reference/
